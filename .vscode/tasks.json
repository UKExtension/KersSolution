{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/Kers/Kers.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "publish",
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish",
                "${workspaceFolder}/Kers/Kers.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "watch",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "run",
                "${workspaceFolder}/Kers/Kers.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "taskName": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/Kers/Kers.csproj"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "start-angular",
            "type": "shell",
            // kill any stray dev-server left listening on 4200 (e.g. from a prior debug session)
            // and pin the port so the CLI never silently falls back to a random one
            "command": "lsof -ti tcp:4200 | xargs kill -9 2>/dev/null; npm start -- --port 4200",
            "options": {
                "cwd": "${workspaceFolder}/Kers/ClientApp"
            },
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^NEVER_MATCH_ANYTHING$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".",
                    "endsPattern": "Local:\\s+https?://"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "group": "kers"
            }
        },
        {
            "label": "debug",
            "dependsOn": ["build", "start-angular"],
            "dependsOrder": "parallel",
            "problemMatcher": []
        }
    ]
}